{
  "manifest_version": 3,
  "name": "BUY NOW OR LIVE - 스케줄 수집기",
  "version": "1.0.0",
  "description": "올리브영/G마켓 라이브 편성표를 주기적으로 수집해 buynoworlive 백엔드로 전송합니다",
  "permissions": ["alarms", "tabs", "scripting", "storage"],
  "host_permissions": [
    "https://m.oliveyoung.co.kr/*",
    "https://m.gmarket.co.kr/*",
    "https://buynoworlive.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BUY NOW OR LIVE 수집기",
    "default_popup": "popup.html"
  }
}
